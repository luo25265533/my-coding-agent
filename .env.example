# LLM（阶段 2 启用；阶段 1 只校验格式，不测试连通性）
# provider=mock 时无需密钥，可离线跑通全流程
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# 切到真实供应商时（OpenAI 兼容端点：OpenAI / DeepSeek / Kimi / 通义 / Ollama）
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Agent
# 沙箱根目录，加载时解析为绝对路径
AGENT_WORKSPACE=.
AGENT_MAX_ITERATIONS=20
AGENT_CONFIRM_HIGH_RISK=true

# 日志
# trace | debug | info | warn | error | fatal | silent
AGENT_LOG_LEVEL=info
# 相对路径基于 AGENT_WORKSPACE 解析，且必须位于 workspace 内
AGENT_LOG_DIR=.agent/logs
AGENT_LOG_PRETTY=true