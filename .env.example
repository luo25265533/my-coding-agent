# LLM（阶段 2 起启用）
# provider=mock 时无需密钥，可离线跑通全流程
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# 切到真实供应商时（OpenAI 兼容端点），三项均必填
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=your-key-here
# LLM_MODEL=glm-5.3
#
# 智谱 BigModel 官方端点（来源：docs.bigmodel.cn 官方文档）
# 通用端点，按量计费：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM Coding Plan 专属端点，订阅配额仅在此可用；
# 用通用端点会返回 429 code=1113 余额不足（已实测）：
# LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#
# 其他供应商示例：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Agent
# 沙箱根目录，加载时解析为绝对路径
AGENT_WORKSPACE=.
AGENT_MAX_ITERATIONS=20
# 规划模式：Plan 最大步骤数（1–50）
AGENT_PLAN_MAX_STEPS=12
# 规划模式：每个步骤的工具循环上限（1–100）
AGENT_STEP_MAX_ITERATIONS=10
# run_command 默认超时毫秒数（1000–600000），超时终止整棵进程树
AGENT_COMMAND_TIMEOUT_MS=30000
# 同一工具+参数连续出现的最大次数，达到即停止（防重复循环）
AGENT_MAX_REPEATED_CALLS=3
# 连续多少轮工具调用全部失败后停止（任一成功清零）
AGENT_MAX_CONSECUTIVE_FAILURES=3
AGENT_CONFIRM_HIGH_RISK=true
# 高风险命令确认等待上限毫秒数（1000–3600000）；超时按拒绝处理并终止当前工具调用
AGENT_CONFIRM_TIMEOUT_MS=300000
# 上下文 token 预算（1000–200000）；超限时先丢弃旧消息组，再对最长工具输出做头尾保留截断
AGENT_CONTEXT_BUDGET_TOKENS=16000
# 是否读取工作区根部的 .gitignore 作为忽略规则（node_modules/.git/dist/coverage/.agent 始终忽略）
AGENT_RESPECT_GITIGNORE=true
# 额外忽略规则，逗号或换行分隔，语法同 .gitignore（支持 ! 反选）
# AGENT_IGNORE=tmp/, *.log
# 仅 LLM_PROVIDER=mock 生效：按步回放模型响应的 JSON 脚本路径（测试/演示用）
# AGENT_MOCK_SCRIPT=.agent/mock-script.json

# 任务可靠性（阶段 7）
# 任务库路径，必须位于 AGENT_WORKSPACE 内，且不能是 .env/密钥类文件名
# 默认位于 .agent/ 下，该目录已被 git 忽略；不要提交任务库
AGENT_TASK_DB=.agent/tasks.db
# 步骤完成后的验证命令；显式留空表示关闭自动验证
# 默认值 pnpm test 在缺少 package.json 的工作区自动跳过；显式指定的命令始终执行
AGENT_VERIFY_COMMAND=pnpm test
# 验证命令超时毫秒数（1000–600000）
AGENT_VERIFY_TIMEOUT_MS=300000
# 改动全为静态资源（文档/样式/图片等）时跳过默认验证命令，避免为静态改动跑全量测试
AGENT_VERIFY_SKIP_STATIC=true
# 验证失败后的最大自动修复轮数（0–10，0 表示关闭）
AGENT_MAX_REPAIR_ATTEMPTS=2
# 每轮修复的 AgentLoop 迭代上限（1–100）
AGENT_REPAIR_MAX_ITERATIONS=8

# 日志
# trace | debug | info | warn | error | fatal | silent
AGENT_LOG_LEVEL=info
# 相对路径基于 AGENT_WORKSPACE 解析，且必须位于 workspace 内
AGENT_LOG_DIR=.agent/logs
AGENT_LOG_PRETTY=true
# 本地 Web UI（阶段 9）
# serve 命令监听端口（1024-65535）
AGENT_WEB_PORT=3210
# 绑定地址；仅允许本机回环（127.0.0.1 / localhost），不支持远程访问
AGENT_WEB_HOST=127.0.0.1
